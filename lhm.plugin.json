    {
      "name": "avito_add_cabinet",
      "description": "Add or update a cabinet (a named set of API credentials), from chat.\n\n⚠️ This puts the key into the chat transcript — requires\ni_understand_key_goes_to_chat=true. The terminal-free safe alternative is\nthe installer (install.py / double-click), where the key never enters chat.\n\nArgs:\n    credentials: dict with the required fields for this service\n        ({fields}). For Ozon: {{\"client_id\": \"...\", \"api_key\": \"...\"}};\n        for WB: {{\"token\": \"...\"}}.\n    name: optional label. If omitted, the cabinet is named after the real\n        shop name fetched from the marketplace (falls back to \"main\").\n    i_understand_key_goes_to_chat: must be true to proceed.\nSaved to ~/.marketplace-mcp/cabinets.json (local, chmod 600), never echoed.",
      "inputSchema": {
        "properties": {
          "credentials": {
            "additionalProperties": true,
            "title": "Credentials",
            "type": "object"
          },
          "name": {
            "default": "",
            "title": "Name",
            "type": "string"
          },
          "i_understand_key_goes_to_chat": {
            "default": false,
