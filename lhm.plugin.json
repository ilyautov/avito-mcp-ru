{
  "identifier": "ilyautov-avito-mcp-ru",
  "name": "Avito MCP (RU)",
  "version": "0.5.3",
  "description": "Avito business API in your AI assistant: listings and statistics, buyer messenger, orders and Avito Delivery, bulk upload, promotion, reviews. 64 methods live in a YAML catalog the server executes; the agent searches it in plain language and calls a method through three generic tools. Every method carries an access class: reads run immediately, writes and irreversible calls require confirmation. Keys stay on the user's machine.",
  "author": "Ilya Utov",
  "authorUrl": "https://github.com/ilyautov",
  "homepage": "https://github.com/ilyautov/avito-mcp-ru",
  "icon": "https://raw.githubusercontent.com/ilyautov/avito-mcp-ru/main/assets/logo.png",
  "tags": [
    "avito",
    "avito-api",
    "classifieds",
    "marketplace",
    "ecommerce",
    "russia"
  ],
  "localizations": [
    {
      "locale": "ru-RU",
      "name": "Avito MCP (RU)",
      "description": "API Авито для ИИ-ассистентов: объявления и статистика, чаты с покупателями, заказы и Авито Доставка, автозагрузка, продвижение, отзывы. Каталог исполняется сервером. 64 методов живут в YAML-каталоге, который исполняет сервер: агент ищет метод словами и вызывает его тремя общими инструментами. У каждого метода класс доступа: чтение идёт сразу, запись и необратимое спрашивают подтверждение. Ключи остаются на машине пользователя."
    }
  ],
